-- ============================================================
-- mart_lead_scoring.sqlx
-- Dataform mart: final lead scoring table consumed by CRM and
-- broker dashboards. Joins propensity scores with argumentation
-- engine output and deduplication layer.
-- ============================================================

config {
  type: "table",
  schema: "mart",
  name: "mart_lead_scoring",
  description: "Daily lead scoring mart. One row per active lead per score_date.",
  tags: ["lead_scoring", "daily", "crm_export"],
  bigquery: {
    partitionBy: "score_date",
    clusterBy: ["lead_tier", "product_target"],
    requirePartitionFilter: true
  }
}

pre_operations {
  -- Remove stale scores older than 7 days to keep costs bounded
  DELETE FROM ${self()} WHERE score_date < DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)
}

WITH

-- Model scores (written daily by Vertex AI batch prediction job)
scores AS (
  SELECT
    lead_id,
    propensity_score,
    lead_tier,              -- HOT / WARM / COLD
    score_date,
    model_version
  FROM ${ref("stg_propensity_scores")}
  WHERE score_date = CURRENT_DATE()
),

-- Deduplication: keep only the highest-priority record per CPF/CNPJ
-- (same customer may appear in multiple CRM pipelines)
deduped AS (
  SELECT
    s.*,
    ROW_NUMBER() OVER (
      PARTITION BY d.cpf_cnpj
      ORDER BY s.propensity_score DESC
    ) AS dedup_rank
  FROM scores             AS s
  INNER JOIN ${ref("dim_leads")} AS l USING (lead_id)
  INNER JOIN ${ref("dim_customers")} AS d ON l.customer_id = d.customer_id
),

-- Argumentation engine: top-N argument codes per lead
-- (generated by a separate LLM-based pipeline)
argumentation AS (
  SELECT
    lead_id,
    ARRAY_AGG(argument_code ORDER BY relevance_score DESC LIMIT 3) AS top_arguments,
    MAX(relevance_score) AS max_argument_relevance
  FROM ${ref("stg_lead_arguments")}
  WHERE argument_date = CURRENT_DATE()
  GROUP BY lead_id
),

-- CRM enrichment
crm AS (
  SELECT
    l.lead_id,
    l.broker_id,
    l.product_target,
    l.assigned_to,
    c.customer_name,
    c.uf,
    c.customer_segment
  FROM ${ref("dim_leads")} AS l
  INNER JOIN ${ref("dim_customers")} AS c ON l.customer_id = c.customer_id
),

-- Behavioral engagement summary (from feature store)
behavior AS (
  SELECT
    lead_id,
    engagement_score,
    days_since_last_engagement,
    answer_rate_90d,
    w30d_n_events
  FROM ${ref("feat_behavioral")}
  WHERE score_date = CURRENT_DATE()
),

final AS (
  SELECT
    -- Identity
    d.lead_id,
    crm.customer_name,
    crm.uf,
    crm.customer_segment,
    crm.broker_id,
    crm.assigned_to,

    -- Scoring
    d.propensity_score,
    d.lead_tier,
    d.model_version,

    -- Product target
    crm.product_target,

    -- Argumentation
    COALESCE(a.top_arguments, [])           AS top_arguments,
    COALESCE(a.max_argument_relevance, 0)   AS max_argument_relevance,

    -- Behavioral context
    b.engagement_score,
    b.days_since_last_engagement,
    b.answer_rate_90d,
    b.w30d_n_events,

    -- Priority rank within broker portfolio
    RANK() OVER (
      PARTITION BY crm.broker_id
      ORDER BY d.propensity_score DESC
    )                                        AS broker_priority_rank,

    -- Best time to call (derived from historical answer patterns — stub)
    CASE
      WHEN b.answer_rate_90d >= 0.5  THEN 'MORNING'
      WHEN b.days_since_last_engagement <= 3 THEN 'AFTERNOON'
      ELSE 'ANY'
    END                                      AS suggested_call_window,

    CURRENT_DATE()                           AS score_date

  FROM deduped AS d
  INNER JOIN crm     ON d.lead_id = crm.lead_id
  LEFT JOIN argumentation AS a ON d.lead_id = a.lead_id
  LEFT JOIN behavior AS b      ON d.lead_id = b.lead_id
  WHERE d.dedup_rank = 1      -- deduplicated: one row per customer
    AND d.lead_tier IN ('HOT', 'WARM')  -- filter COLD leads from CRM export
)

SELECT * FROM final
ORDER BY propensity_score DESC
